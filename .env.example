# UniMap username/password login (dispatch.uniuni.com)
UNIUNI_USERNAME=
UNIUNI_PASSWORD=
UNIUNI_PORTAL_URL=https://dispatch.uniuni.com/login
# Optional: reuse UniMap session cookies locally (~24h)
UNIUNI_AUTH_STATE_PATH=.uniuni-auth-state.json

# Google Sheet
# Local: path to service account JSON file
# GitHub Actions: GOOGLE_CREDENTIALS secret = full JSON string
GOOGLE_CREDENTIALS=google-service-account.json
GOOGLE_SHEETS_ID=13wcr_gIdA02ctaj8_NYMkFr5pueh-oR6sTJl02z2cYs
GOOGLE_SHEET_NAME=subbatch scrape
GOOGLE_WORKSHEET_NAME=subbatch scrape

# Supabase
SUPABASE_URL=https://xllimmgxkttjzaikimtu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides
# Default batch resolution uses Eastern clock (NJSUB-YYYYMMDD2100).
# Set SUBBATCH to force a specific batch; sheet is only used with --use-sheet.
SUBBATCH=
MACHINE_ID=9
